# ============================================
# Thor Bot — Environment Variables Template
# ============================================
# Copy this file to .env and fill in the real values.
#   cp .env.example .env
#
# NEVER commit the .env file to git (it is already in .gitignore).
# NEVER share your Discord/GitHub token in public chats.
# ============================================

# === DISCORD TOKEN (REQUIRED) ===
# Get it from: https://discord.com/developers/applications → Bot → Reset Token
# This token is the bot's primary credential. If it leaks, reset it immediately
# in the Discord Developer Portal.
DISCORD_TOKEN=

# === GUILD ID (REQUIRED for instant command registration) ===
# The ID of the Discord server where the bot is deployed.
# How to get it: enable Discord Developer Mode (Settings → Advanced → Developer Mode),
#                then right-click the server name → Copy Server ID.
# If not set, the bot falls back to global commands (~1 hour of propagation needed).
# v3.9.26: when set, the bot also IGNORES all events (messages/commands/buttons)
# from other servers — insurance in case the bot is accidentally invited to a second server.
GUILD_ID=

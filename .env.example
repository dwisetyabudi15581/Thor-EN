# ============================================
# Thor Bot — Environment Variables Template
# ============================================
# Copy this file to .env and fill in the real values.
#   cp .env.example .env
#
# NEVER commit the .env file to git (it is already in .gitignore).
# NEVER share your Discord/GitHub token in public chats.
# ============================================

# === DISCORD TOKEN (REQUIRED) ===
# Get it from: https://discord.com/developers/applications → Bot → Reset Token
# This token is the bot's primary credential. If it leaks, reset it immediately
# in the Discord Developer Portal.
DISCORD_TOKEN=

# === GUILD ID (THE ONLY server variable — v3.12.0) ===
# This is the ONE place to configure your server. Switching servers = edit
# this value. That's it.
#
# How to get the ID: enable Discord Developer Mode (Settings → Advanced →
#                    Developer Mode), then right-click the server name →
#                    Copy Server ID.
#
# TWO MODES, one variable:
#
# 1. SET (default — single-server / private mode):
#    - Slash commands are registered instantly (seconds) to this server.
#    - Events from other servers (messages/joins/boosts/tickets) are
#      IGNORED — insurance in case the bot is accidentally invited to a
#      second server.
#    GUILD_ID=111111111111111111
#
# 2. EMPTY (public mode — like the big public bots):
#    - Slash commands are registered GLOBALLY: they appear automatically
#      in EVERY server that invites the bot (~1 hour propagation) — no
#      manual guild id anywhere, exactly like big public bots.
#    - Configs are isolated per-server automatically (data/config/<guildId>.json).
#    GUILD_ID=

# === WEB DASHBOARD API (v3.17.0) — used by the Next.js dashboard ===
# The bot runs a small HTTP API (localhost only by default) that the web
# dashboard (web) reads/writes. Without DASH_API_TOKEN the server
# does NOT run (safe by default). The token must be IDENTICAL to the
# DASH_API_TOKEN in the web dashboard's .env.
DASH_API_HOST=127.0.0.1
DASH_API_PORT=8788
DASH_API_TOKEN=
GUILD_ID=

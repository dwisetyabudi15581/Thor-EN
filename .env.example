# ============================================
# Thor Bot — Environment Variables Template
# ============================================
# Copy file ini ke .env dan isi nilai sebenarnya.
#   cp .env.example .env
#
# JANGAN commit file .env ke git (sudah ada di .gitignore).
# JANGAN share token Discord/GitHub di chat publik.
# ============================================

# === DISCORD TOKEN (WAJIB) ===
# Dapatkan dari: https://discord.com/developers/applications → Bot → Reset Token
# Token ini adalah credential utama bot. Kalau bocor, segera reset di Discord Developer Portal.
DISCORD_TOKEN=

# === GUILD ID (WAJIB untuk registrasi command instan) ===
# ID server Discord tempat bot di-deploy.
# Cara dapatkan: Developer Mode Discord (Settings → Advanced → Developer Mode),
#                lalu right-click server name → Copy Server ID.
# Kalau tidak di-set, bot fallback ke global commands (perlu ~1 jam propagasi).
# v3.9.26: kalau di-set, bot juga MENGABAIKAN semua event (pesan/command/button)
# dari server lain — asuransi kalau bot tak sengaja di-invite ke server kedua.
GUILD_ID=

# ============================================
# Thor Bot — Environment Variables Template
# ============================================
# Copy this file to .env and fill in the real values.
#   cp .env.example .env
#
# NEVER commit the .env file to git (it is already in .gitignore).
# NEVER share your Discord/GitHub token in public chats.
# ============================================

# === DISCORD TOKEN (REQUIRED) ===
# Get it from: https://discord.com/developers/applications → Bot → Reset Token
# This token is the bot's primary credential. If it leaks, reset it immediately
# in the Discord Developer Portal.
DISCORD_TOKEN=

# === GUILD ID (REQUIRED for instant command registration) ===
# The ID of the Discord server where the bot is deployed.
# How to get it: enable Discord Developer Mode (Settings → Advanced → Developer Mode),
#                then right-click the server name → Copy Server ID.
# If not set, the bot falls back to global commands (~1 hour of propagation needed).
# v3.9.26: when set, the bot also IGNORES all events (messages/commands/buttons)
# from other servers — insurance in case the bot is accidentally invited to a second server.
GUILD_ID=

# === ALLOWED GUILD IDS (v3.11.0 — multi-guild allowlist, OPTIONAL) ===
# A comma-separated list of Discord server IDs the bot may serve.
# Priority: ALLOWED_GUILD_IDS > GUILD_ID > neither set (open mode).
#   - Set (1 or more IDs): only the listed servers are processed. Slash commands
#     are registered per-guild (INSTANT) in every listed server, and guilds
#     outside the list never even see the commands. The bot's events (messages,
#     joins, boosts, tickets, etc.) from unlisted servers are ignored.
#   - Not set: the single GUILD_ID above is used as a one-entry allowlist
#     (the old v3.9.26 behavior — nothing changes for existing deployments).
#   - Neither set: OPEN MODE — every server that invites the bot gets full
#     access (global commands, ~1 hour propagation).
# Examples:
#   ALLOWED_GUILD_IDS=111111111111111111
#   ALLOWED_GUILD_IDS=111111111111111111,222222222222222222
# Adding a new server: invite the bot, add its ID here, restart the bot.
ALLOWED_GUILD_IDS=

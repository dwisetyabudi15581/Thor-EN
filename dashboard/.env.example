# Thor Dashboard configuration (free bot)
# Copy this file to .env.local (development) or paste the values into your
# hosting environment variables (production). NEVER commit .env* files.

# SQLite database (relative to the dashboard/ folder — where commands are run)
DATABASE_URL=file:db/custom.db

# Session cookie signing key — MUST be replaced with a long random string
# in production (e.g. the output of `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string

# Demo login (member & admin) — automatically disabled once DISCORD_CLIENT_ID
# is filled in; force on/off with true/false
DEMO_MODE=false

# ===== Discord OAuth2 (Developer Portal -> application -> OAuth2) =====
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The redirect URI registered in the portal — the dashboard shows the exact
# address on the login page (the "Bot owner setup" box); copy it from there:
#   https://<dashboard-domain>/api/auth/discord/callback
# Fixed origin (REQUIRED in production for consistent OAuth redirects):
#   PUBLIC_ORIGIN=https://thor.yourdomain.com
PUBLIC_ORIGIN=

# Discord IDs (comma-separated) that automatically become dashboard admins
ADMIN_DISCORD_IDS=

# ===== Thor bot DASH API (REQUIRED — the bridge between dashboard & bot) =====
# Must be EXACTLY the same as in the Thor bot's .env:
#   DASH_API_URL=http://127.0.0.1:8788   (bot and web on the same VPS)
#   DASH_API_TOKEN=<the-same-random-token-on-both-sides>
DASH_API_URL=http://127.0.0.1:8788
DASH_API_TOKEN=

# Bot invite link for the "Invite Thor" button (optional — has a default)
NEXT_PUBLIC_INVITE_URL=

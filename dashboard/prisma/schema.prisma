generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Dashboard users — identity from Discord OAuth (or demo mode during setup)
model User {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  globalName  String?
  avatar      String?
  isAdmin     Boolean  @default(false)
  // v2 (Dyno-style dashboard): the user's OAuth token (identify+guilds
  // scope) — used by /api/guilds for the server list + ManageGuild check.
  accessToken  String?
  refreshToken String?
  tokenExpiresAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

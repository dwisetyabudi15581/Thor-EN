# ============================================================
# Thor-EN v4.1.0 — the DISCORD BOT repository (bot-only)
# The web dashboard lives in its own repo: Thor-EN-Dashboard
# ============================================================

# === Dependencies (never commit) ===
node_modules/

# === Environment variables (SENSITIVE — never commit) ===
.env
.env.bak
.env.local
.env.*.local

# === Bot runtime data (data/) — JSON persistence ===
# v3.9.10: file data JSON lives in the data/ folder.
data/*.json
# v3.10.0: config per-guild — data/config/<guildId>.json (multi-guild).
data/config/
# v3.20.0: custom commands per-guild — data/customCommands/<guildId>.json.
data/customCommands/
# legacy pre-v3.9.10 files (match at any depth)
config.json
scheduledRoles.json
keys.json
selfRoles.json
giveaways.json
warns.json
polls.json
scheduledAnnouncements.json
stats.json
tempVoice.json
tickets.json

# v3.10.0: legacy config migration marker (runtime — never commit)
config.json.migrated
data/config.json.migrated

# Corrupt-file quarantine (safeWrite pattern) — can appear at any time at
# runtime, including corrupt-file test residue (v3.9.43: modlogs.json.corrupt-*).
data/*.corrupt-*
*.corrupt-*

# === Bot backup folder ===
backups/
bot/backups/

# === Logs ===
*.log
npm-debug.log*

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# === OS ===
Thumbs.db

# === Test coverage ===
coverage/
.nyc_output/

# ============================================================
# Thor-EN v4.0.0 — two independent modules: bot/ + dashboard/
# ============================================================

# === Dependencies (any module — never commit) ===
node_modules/

# === Environment variables (SENSITIVE — never commit) ===
# Applies to bot/.env and dashboard/.env alike (any depth).
.env
.env.bak
.env.local
.env.*.local

# === Bot runtime data (bot/data/) — JSON persistence ===
# v3.9.10: file data JSON lives in the data/ folder; v4.0.0 moved that
# folder under bot/. Kalau file lama masih ada di root (pre-v3.9.10),
# pola tanpa leading slash di bawah tetap menangkapnya.
bot/data/*.json
# v3.10.0: config per-guild — bot/data/config/<guildId>.json (multi-guild).
bot/data/config/
# v3.20.0: custom commands per-guild — bot/data/customCommands/<guildId>.json.
bot/data/customCommands/
# legacy pre-v3.9.10 files (match at any depth)
config.json
scheduledRoles.json
keys.json
selfRoles.json
giveaways.json
warns.json
polls.json
scheduledAnnouncements.json
stats.json
tempVoice.json
tickets.json

# v3.10.0: legacy config migration marker (runtime — never commit)
config.json.migrated
bot/data/config.json.migrated

# Corrupt-file quarantine (safeWrite pattern) — can appear at any time at
# runtime, including corrupt-file test residue (v3.9.43: modlogs.json.corrupt-*).
bot/data/*.corrupt-*

# === Bot backup folder (bot/backups/) ===
bot/backups/
backups/

# === Logs ===
*.log
npm-debug.log*

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# === OS ===
Thumbs.db

# === Test coverage ===
coverage/
.nyc_output/

# === Web dashboard (dashboard/) — build & runtime artifacts ===
dashboard/.next/
dashboard/.build-version
dashboard/tsconfig.tsbuildinfo
dashboard/db/*
!dashboard/db/.gitkeep
